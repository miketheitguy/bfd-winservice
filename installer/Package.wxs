<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <!-- Protected ACLs also secure pre-existing objects with permissive inheritance.
       Only SYSTEM and administrators may modify the installed code or registration. -->
  <?define BfdServiceSid = "S-1-5-80-1071555646-3639003188-2623042311-1024194528-3093158512" ?>
  <?define FileSecurity = "O:SYG:SYD:P(A;;FA;;;SY)(A;;FA;;;BA)(A;;FRFX;;;BU)(A;;FRFX;;;$(var.BfdServiceSid))" ?>
  <?define DirectorySecurity = "O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FRFX;;;BU)(A;OICI;FRFX;;;$(var.BfdServiceSid))" ?>
  <?define ParametersSecurity = "O:SYG:SYD:P(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;KR;;;$(var.BfdServiceSid))" ?>
  <?define StatusRegistrationSecurity = "O:SYG:SYD:P(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;KR;;;BU)(A;CI;KR;;;LS)" ?>
  <!-- Self-relative REG_BINARY descriptors: execute + local execute (0x3),
       and execute + local launch + local activation (0xb). No remote grants. -->
  <?define StatusAccessPermission = "010004901400000020000000000000002C00000001010000000000051200000001010000000000051200000002003400020000000000140003000000010100000000000512000000000018000300000001020000000000052000000020020000" ?>
  <?define StatusLaunchPermission = "010004901400000020000000000000002C0000000101000000000005120000000101000000000005120000000200340002000000000014000B000000010100000000000512000000000018000B00000001020000000000052000000020020000" ?>
  <?define LogSecurity = "O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FRFX;;;BU)(A;OICI;0x1301bf;;;$(var.BfdServiceSid))" ?>
  <!-- Query config/status, enumerate dependents, interrogate, and read the DACL
       remain available to authenticated users. Only SYSTEM and administrators
       can start, stop, reconfigure, or send custom controls to either service. -->
  <?define ServiceSecurity = "O:SYG:SYD:P(A;;0xf01ff;;;SY)(A;;0xf01ff;;;BA)(A;;0x2008d;;;AU)" ?>
  <Package Name="BFD Windows Service" Manufacturer="BFD Windows Service"
           Version="$(var.ProductVersion)" Language="1033" Scope="perMachine"
           UpgradeCode="F044EF3A-595B-4870-A9E0-96C1D315B073" InstallerVersion="500">
    <MajorUpgrade Schedule="afterInstallExecute" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer BFD Windows Service is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="BFD_WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Bitness="always64"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <util:QueryNativeMachine />
    <Launch Condition="Privileged"
            Message="Administrator privileges are required to install or maintain BFD Windows Service. Run the installer as an administrator." />
    <Launch Condition="Installed OR (VersionNT64 AND BFD_WINDOWS_BUILD &gt;= 10240 AND (WIX_NATIVE_MACHINE = 34404 OR NOT WIX_NATIVE_MACHINE))"
            Message="BFD Windows Service requires x64 Windows 10 or Windows Server 2016 or later." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BfdWinService">
        <Component Id="InstallDirectoryComponent" Guid="6B020FE8-D545-47E2-844E-A6E49DF8E371" Bitness="always64">
          <CreateFolder>
            <PermissionEx Id="InstallDirectorySecurity" Sddl="$(var.DirectorySecurity)" />
          </CreateFolder>
          <RemoveFolder Id="RemoveInstallDirectory" On="uninstall" />
        </Component>
        <Component Id="ServiceComponent" Bitness="always64">
          <File Id="ServiceExe" Source="$(var.RepositoryRoot)\target\x86_64-pc-windows-msvc\release\bfd-winservice.exe"
                KeyPath="yes">
            <PermissionEx Id="ServiceExeSecurity" Sddl="$(var.FileSecurity)" />
          </File>
          <ServiceInstall Id="InstallBfdService" Name="BfdWinService"
                          DisplayName="BFD Windows Service"
                          Description="Monitors a configured peer with Bidirectional Forwarding Detection."
                          Type="ownProcess" Start="auto" Account="NT AUTHORITY\LocalService"
                          ErrorControl="normal" Vital="yes">
            <ServiceDependency Id="BfdBgpBroker" />
            <ServiceDependency Id="RpcSs" />
            <PermissionEx Id="BfdServiceSecurity" Sddl="$(var.ServiceSecurity)" />
            <!-- ConfigureServicePolicy also enables delayed start and recovery after a
                 nonzero exit. Administrator Stop requests always exit with code 0. -->
            <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                                ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
          </ServiceInstall>
          <!-- Configuration and SEHOP policy are provisioned before the first start. -->
          <ServiceControl Id="ControlBfdService" Name="BfdWinService"
                          Stop="both" Remove="uninstall" Wait="yes" />
          <firewall:FirewallException Id="ControlInbound" Name="BfdWinService - control inbound"
                    Description="Classical BFD and S-BFD reflector requests."
                    File="ServiceExe" Protocol="udp" Port="3784,4784,7784" Action="allow" Enabled="yes"
                    RemotePort="49152-65535" Profile="all" Scope="any" IgnoreFailure="no" />
          <firewall:FirewallException Id="SbfdReplyInbound" Name="BfdWinService - S-BFD replies inbound"
                    Description="S-BFD responses to the initiator source port."
                    File="ServiceExe" Protocol="udp" Port="49152-65535" Action="allow" Enabled="yes"
                    RemotePort="7784" Profile="all" Scope="any" IgnoreFailure="no" />
          <firewall:FirewallException Id="ProbeOutbound" Name="BfdWinService - probes outbound"
                    Description="Classical BFD packets and S-BFD initiator requests."
                    File="ServiceExe" Protocol="udp" Port="49152-65535" Action="allow" Enabled="yes"
                    RemotePort="3784,4784,7784" Outbound="yes"
                    Profile="all" Scope="any" IgnoreFailure="no" />
          <firewall:FirewallException Id="SbfdReplyOutbound" Name="BfdWinService - S-BFD replies outbound"
                    Description="S-BFD reflector responses to initiators."
                    File="ServiceExe" Protocol="udp" Port="7784" Action="allow" Enabled="yes"
                    RemotePort="49152-65535" Outbound="yes"
                    Profile="all" Scope="any" IgnoreFailure="no" />
        </Component>
        <Component Id="BrokerComponent" Bitness="always64">
          <File Id="BrokerExe" Source="$(var.RepositoryRoot)\target\x86_64-pc-windows-msvc\release\bfd-bgp-broker.exe" KeyPath="yes">
            <PermissionEx Id="BrokerExeSecurity" Sddl="$(var.FileSecurity)" />
          </File>
          <ServiceInstall Id="InstallBgpBroker" Name="BfdBgpBroker" DisplayName="BFD BGP Management Broker"
                          Description="Controls the configured BGP peer through an authenticated local pipe."
                          Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal" Vital="yes">
            <ServiceDependency Id="RpcSs" />
            <PermissionEx Id="BrokerServiceSecurity" Sddl="$(var.ServiceSecurity)" />
            <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                                ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="ControlBgpBroker" Name="BfdBgpBroker" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="ManifestComponent" Bitness="always64">
          <File Id="EventManifest" Source="$(var.RepositoryRoot)\events\BFD-Service.man" KeyPath="yes">
            <PermissionEx Id="EventManifestSecurity" Sddl="$(var.FileSecurity)" />
            <util:EventManifest MessageFile="[#ServiceExe]" ResourceFile="[#ServiceExe]" />
          </File>
        </Component>
        <Component Id="LoggingScriptComponent" Bitness="always64">
          <File Source="$(var.RepositoryRoot)\scripts\Initialize-Logging.ps1" KeyPath="yes">
            <PermissionEx Id="LoggingScriptSecurity" Sddl="$(var.FileSecurity)" />
          </File>
        </Component>
        <!-- COM activation starts the existing SCM service. There is no alternate
             LocalServer32 executable or DLL surrogate. Standard MSI registry
             actions provide install, repair, rollback, and uninstall behavior. -->
        <Component Id="StatusClassRegistration" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{E4A97D25-73E2-4E6C-9A35-281B6AE697C3}">
            <RegistryValue Id="StatusClassName" Type="string" Value="BFD Windows Service status" KeyPath="yes">
              <PermissionEx Id="StatusClassSecurity" Sddl="$(var.StatusRegistrationSecurity)" />
            </RegistryValue>
            <RegistryValue Id="StatusClassAppId" Name="AppID" Type="string" Value="{954E4BD0-8B46-4A93-B43A-35A4A40ED8F7}" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{E4A97D25-73E2-4E6C-9A35-281B6AE697C3}\ProgID">
            <RegistryValue Id="StatusClassProgId" Type="string" Value="BfdWinService.Status.1" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{E4A97D25-73E2-4E6C-9A35-281B6AE697C3}\VersionIndependentProgID">
            <RegistryValue Id="StatusClassVersionIndependentProgId" Type="string" Value="BfdWinService.Status" />
          </RegistryKey>
        </Component>
        <Component Id="StatusProgIdRegistration" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\BfdWinService.Status.1">
            <RegistryValue Id="StatusProgIdName" Type="string" Value="BFD Windows Service status" KeyPath="yes">
              <PermissionEx Id="StatusProgIdSecurity" Sddl="$(var.StatusRegistrationSecurity)" />
            </RegistryValue>
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\BfdWinService.Status.1\CLSID">
            <RegistryValue Id="StatusProgIdClsid" Type="string" Value="{E4A97D25-73E2-4E6C-9A35-281B6AE697C3}" />
          </RegistryKey>
        </Component>
        <Component Id="StatusVersionIndependentProgIdRegistration" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\BfdWinService.Status">
            <RegistryValue Id="StatusVersionIndependentProgIdName" Type="string" Value="BFD Windows Service status" KeyPath="yes">
              <PermissionEx Id="StatusVersionIndependentProgIdSecurity" Sddl="$(var.StatusRegistrationSecurity)" />
            </RegistryValue>
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\BfdWinService.Status\CLSID">
            <RegistryValue Id="StatusVersionIndependentProgIdClsid" Type="string" Value="{E4A97D25-73E2-4E6C-9A35-281B6AE697C3}" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\BfdWinService.Status\CurVer">
            <RegistryValue Id="StatusVersionIndependentProgIdCurVer" Type="string" Value="BfdWinService.Status.1" />
          </RegistryKey>
        </Component>
        <Component Id="StatusAppRegistration" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\AppID\{954E4BD0-8B46-4A93-B43A-35A4A40ED8F7}">
            <RegistryValue Id="StatusAppName" Type="string" Value="BFD Windows Service status" KeyPath="yes">
              <PermissionEx Id="StatusAppSecurity" Sddl="$(var.StatusRegistrationSecurity)" />
            </RegistryValue>
            <RegistryValue Id="StatusAppService" Name="LocalService" Type="string" Value="BfdWinService" />
            <RegistryValue Id="StatusAppAuthenticationLevel" Name="AuthenticationLevel" Type="integer" Value="5" />
            <RegistryValue Id="StatusAppAccessPermission" Name="AccessPermission" Type="binary" Value="$(var.StatusAccessPermission)" />
            <RegistryValue Id="StatusAppLaunchPermission" Name="LaunchPermission" Type="binary" Value="$(var.StatusLaunchPermission)" />
          </RegistryKey>
        </Component>
        <Component Id="StatusExeRegistration" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\AppID\bfd-winservice.exe">
            <RegistryValue Id="StatusExeAppId" Name="AppID" Type="string" Value="{954E4BD0-8B46-4A93-B43A-35A4A40ED8F7}" KeyPath="yes">
              <PermissionEx Id="StatusExeAppSecurity" Sddl="$(var.StatusRegistrationSecurity)" />
            </RegistryValue>
          </RegistryKey>
        </Component>
        <!-- Separate key paths prevent repair from resetting administrator settings. -->
        <Component Id="MultihopDefault" Bitness="always64" NeverOverwrite="yes">
          <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BfdWinService\Parameters"
                         Name="Multihop" Type="integer" Value="0" KeyPath="yes" />
        </Component>
        <Component Id="LogToFileDefault" Bitness="always64" NeverOverwrite="yes">
          <RegistryValue Id="LogToFileDefaultValue" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BfdWinService\Parameters"
                         Name="LogToFile" Type="integer" Value="0" KeyPath="yes" />
        </Component>
        <!-- A separate repairable component secures existing Parameters keys even
             when NeverOverwrite preserves all administrator-selected defaults. -->
        <Component Id="ParametersSecurityComponent" Bitness="always64">
          <RegistryValue Id="ParametersPolicyValue" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BfdWinService\Parameters"
                         Name="_InstallerPolicy" Type="integer" Value="1" KeyPath="yes">
            <PermissionEx Id="ParametersSecurity" Sddl="$(var.ParametersSecurity)" />
          </RegistryValue>
        </Component>
        <Component Id="LogFilePathDefault" Bitness="always64" NeverOverwrite="yes">
          <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BfdWinService\Parameters"
                         Name="LogFilePath" Type="string" Value="[LOGFOLDER]trace.log" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="LOGFOLDER" Name="BfdWinService">
        <Component Id="LogDirectoryComponent" Guid="1C76D609-E33A-4A9D-A2DB-B97E78153312" Bitness="always64">
          <CreateFolder>
            <PermissionEx Id="LogDirectorySecurity" Sddl="$(var.LogSecurity)" />
          </CreateFolder>
          <!-- Remove only an empty folder; user-generated logs are retained. -->
          <RemoveFolder Id="RemoveLogDirectory" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <!-- Fixed-target native SCM actions avoid the documented MsiConfigureServices
         limitation. Snapshot before installation; restore accounts, SIDs, delayed
         start, and non-crash recovery on rollback. -->
    <CustomAction Id="PrepareServicePolicy" FileRef="BrokerExe" ExeCommand="--prepare-install" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackServicePolicy" FileRef="BrokerExe" ExeCommand="--rollback-install" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ConfigureServicePolicy" FileRef="BrokerExe" ExeCommand="--configure-install" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CommitServicePolicy" FileRef="BrokerExe" ExeCommand="--commit-install" Execute="commit" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RollbackServicePolicy" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PrepareServicePolicy" After="RollbackServicePolicy" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ConfigureServicePolicy" After="InstallServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitServicePolicy" After="ConfigureServicePolicy" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <Feature Id="ServiceFeature" Title="BFD Windows Service" Level="1">
      <ComponentRef Id="InstallDirectoryComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="BrokerComponent" />
      <ComponentRef Id="ManifestComponent" />
      <ComponentRef Id="LoggingScriptComponent" />
      <ComponentRef Id="StatusClassRegistration" />
      <ComponentRef Id="StatusProgIdRegistration" />
      <ComponentRef Id="StatusVersionIndependentProgIdRegistration" />
      <ComponentRef Id="StatusAppRegistration" />
      <ComponentRef Id="StatusExeRegistration" />
      <ComponentRef Id="MultihopDefault" />
      <ComponentRef Id="LogToFileDefault" />
      <ComponentRef Id="ParametersSecurityComponent" />
      <ComponentRef Id="LogFilePathDefault" />
      <ComponentRef Id="LogDirectoryComponent" />
    </Feature>
  </Package>
</Wix>
