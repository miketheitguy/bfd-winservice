        </object>
        <object id="statusRegistration2" label="&lt;b&gt;F0 | Protected HKLM 64-bit COM registration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;ProgID → CLSID → AppID&lt;br&gt;AppID LocalService = BfdWinService (SCM service name)&lt;br&gt;SYSTEM / Admins: LaunchPermission 0xB; AccessPermission 0x3&lt;br&gt;AuthenticationLevel = 5; no remote launch / activation / access&lt;br&gt;Registration reads do not grant endpoint query permission&lt;/span&gt;" Source="installer/Package.wxs: StatusProgIdRegistration / StatusClassRegistration / StatusAppIdRegistration" tooltip="Source: installer/Package.wxs: StatusProgIdRegistration / StatusClassRegistration / StatusAppIdRegistration">
          <mxCell style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
            <mxGeometry x="1740" y="405" width="780" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="statusService2" label="&lt;b&gt;F1-F3 | Service-hosted COM status object&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;Security initialized once; class registered before SCM Running&lt;br&gt;MTA owns registration; RPC workers execute calls&lt;br&gt;Packet integrity; authenticated local ncalrpc context required&lt;br&gt;Factory + each IDispatch metadata / method / property call checks the caller&lt;br&gt;TOKEN_QUERY + OpenAsSelf; SYSTEM or enabled Admin membership&lt;br&gt;Checked RevertToSelf BEFORE snapshot reads / formatting&lt;br&gt;No process-token fallback; no BGP or configuration writes&lt;/span&gt;" Source="src/service.rs; src/status_com.rs" tooltip="Source: src/service.rs; src/status_com.rs">
          <mxCell style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="bfd2">
            <mxGeometry x="850" y="105" width="725" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="statusStore2" label="&lt;b&gt;ArcSwap immutable snapshot store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;Engine publishes every 1 second; queries retain an Arc&lt;br&gt;No authentication keys; no SCM lifecycle fields&lt;br&gt;After engine exit: new GetSnapshot() returns null&lt;/span&gt;" Source="src/runtime/status.rs; src/status_com.rs: StatusObject" tooltip="Source: src/runtime/status.rs; src/status_com.rs: StatusObject">
          <mxCell style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="bfd2">
