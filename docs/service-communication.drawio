        <mxCell id="statusNote" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="1" value="&lt;b&gt;SERVICE STATUS AND SESSION STATUS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;SCM: Running / Stopped for local readers.&lt;br&gt;COM: BFD state / counters for local SYSTEM / enabled Admins.&lt;br&gt;Logs: historical transitions under existing Windows ACLs.&lt;br&gt;Ordinary / filtered / remote callers: no status COM access.&lt;/span&gt;">
          <mxGeometry x="1210" y="1680" width="1310" height="135" as="geometry" />
        </mxCell>
