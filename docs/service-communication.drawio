        <object label="&lt;b&gt;STATUS COM HOST / RPC CALLS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;MTA thread owns registration; RPC workers handle queries&lt;/span&gt;" Source="src/status_com.rs: StatusComServer / Apartment" tooltip="Source: src/status_com.rs: StatusComServer / Apartment" id="comHost">
          <mxCell parent="bfd" style="swimlane;horizontal=1;startSize=60;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=18;align=left;verticalAlign=middle;spacingLeft=20;fontColor=#172B4D;fillColor=#DAE8FC;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1">
            <mxGeometry height="665" width="860" x="1360" y="85" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;F1 | Authenticate COM calls&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;Process security: SYSTEM / Admins, access 0x3&lt;br&gt;PKT_INTEGRITY (level 5); disable AAA / custom marshal&lt;br&gt;Require CoGetCallContext&amp;lt;IServerSecurity&amp;gt;&lt;br&gt;Factory + every IDispatch call checked&lt;/span&gt;" Source="src/status_com.rs: initialize_security / authorize_caller" tooltip="Source: src/status_com.rs: initialize_security / authorize_caller" id="comAuth">
          <mxCell parent="comHost" style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1">
            <mxGeometry height="155" width="360" x="30" y="100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;F2 | Require an authenticated local caller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;RPC call attributes: local ncalrpc / LRPC&lt;br&gt;Reject remote, unknown locality, and NullSession&lt;br&gt;ImpersonateClient only to inspect caller identity&lt;br&gt;No SeImpersonatePrivilege retained by service&lt;/span&gt;" Source="src/status_com.rs: authorize_caller" tooltip="Source: src/status_com.rs: authorize_caller" id="comLocal">
          <mxCell parent="comHost" style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1">
            <mxGeometry height="155" width="365" x="460" y="100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;F2 | Inspect the actual caller token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;OpenThreadToken: TOKEN_QUERY, OpenAsSelf = true&lt;br&gt;CheckTokenMembership: SYSTEM or enabled Admin SID&lt;br&gt;Deny-only UAC Administrator SID does not qualify&lt;br&gt;Missing token / API errors / failed membership: deny&lt;/span&gt;" Source="src/status_com.rs: authorized_token / TokenHandle" tooltip="Source: src/status_com.rs: authorized_token / TokenHandle" id="comToken">
          <mxCell parent="comHost" style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1">
            <mxGeometry height="155" width="365" x="460" y="315" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;F3 | End caller identification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;Close caller token; checked RevertToSelf&lt;br&gt;Revert failure denies the call; RAII retries cleanup&lt;br&gt;Restore service identity BEFORE snapshot work&lt;br&gt;No configuration, BGP, or service-control methods&lt;/span&gt;" Source="src/status_com.rs: CallerImpersonation / authorize_caller" tooltip="Source: src/status_com.rs: CallerImpersonation / authorize_caller" id="comRevert">
          <mxCell parent="comHost" style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1">
            <mxGeometry height="155" width="360" x="30" y="315" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Read-only Automation snapshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;GetSnapshot() loads Arc from the published store&lt;br&gt;RPC workers format / marshal 55 typed properties&lt;br&gt;Engine stopped: null; retained snapshots stay immutable&lt;br&gt;BFD loop never executes COM queries or marshaling&lt;/span&gt;" Source="src/status_com.rs: StatusObject / SnapshotObject; src/runtime/status.rs" tooltip="Source: src/status_com.rs: StatusObject / SnapshotObject; src/runtime/status.rs" id="comObject">
