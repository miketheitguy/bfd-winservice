        <object label="&lt;b&gt;BFD PROCESS TOKEN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;LocalService + NT SERVICE\BfdWinService&lt;br&gt;Retains SeChangeNotifyPrivilege and&lt;br&gt;SeCreateGlobalPrivilege only&lt;br&gt;Removes SeImpersonatePrivilege and&lt;br&gt;SeAssignPrimaryTokenPrivilege before COM / UDP&lt;br&gt;Caller token is never substituted for provider work&lt;/span&gt;" Source="src/runtime/privileges.rs; src/bgp_broker/install.rs" tooltip="Source: src/runtime/privileges.rs; src/bgp_broker/install.rs" id="privileges">
          <mxCell parent="1" style="rounded=1;arcSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#B0B0B0;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fontSize=14;align=left;" vertex="1">
