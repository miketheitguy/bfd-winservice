        </object>
        <object id="brokerPrivate2" label="&lt;b&gt;PRIVATE COM FOR LOCAL MI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;Broker process identity: LocalSystem + broker service SID&lt;br&gt;Provider operations run after pipe identification is reverted&lt;br&gt;This private client does not host the status COM object&lt;/span&gt;" Source="src/bgp_broker/com.rs; src/bgp_broker/mi.rs" tooltip="Source: src/bgp_broker/com.rs; src/bgp_broker/mi.rs">
          <mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;" vertex="1" parent="broker2">
