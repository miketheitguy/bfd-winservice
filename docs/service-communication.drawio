        <object id="statusClient2" label="&lt;b&gt;Local 64-bit PowerShell status client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;BfdWinService.Status.1 / GetSnapshot()&lt;br&gt;Caller Windows token: SYSTEM or enabled Administrator&lt;br&gt;Read-only BFD functionality; SCM supplies service status&lt;/span&gt;" Source="docs/monitoring.md; src/status_com.rs" tooltip="Source: docs/monitoring.md; src/status_com.rs">
          <mxCell style="rounded=1;arcSize=12;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#172B4D;spacing=12;fillColor=#F5F5F5;strokeColor=#B0B0B0;" vertex="1" parent="admin">
            <mxGeometry x="1660" y="80" width="780" height="95" as="geometry" />
