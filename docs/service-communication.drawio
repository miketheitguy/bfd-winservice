<mxfile host="app.diagrams.net" type="device" pages="3">
  <diagram name="1 Runtime boundaries" id="runtime">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1780" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Service communication and trust boundaries&lt;/b&gt;&lt;br&gt;Packet engine drives BGP actions; authenticated telemetry is observational" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=25;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bfd" value="&lt;b&gt;BfdWinService | bfd-winservice.exe&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="560" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;BfdBgpBroker | bfd-bgp-broker.exe&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="180" width="600" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="bfd-token" value="&lt;b&gt;BFD process identity&lt;/b&gt;&lt;br&gt;LocalService + restricted BFD service SID&lt;br&gt;SeChangeNotifyPrivilege + SeCreateGlobalPrivilege&lt;br&gt;Validate identity before configured resources" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="90" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;[A] BFD / S-BFD packet engine&lt;/b&gt;&lt;br&gt;One owner of mutable session and timers&lt;br&gt;Path validation + optional BFD wire authentication&lt;br&gt;Engine state drives the separate BGP worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="305" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="publisher" value="&lt;b&gt;Immutable status publication&lt;/b&gt;&lt;br&gt;ArcSwap snapshot + coherent capture metadata&lt;br&gt;Changes: 100 ms minimum; refresh target: 1 s&lt;br&gt;Scheduling can delay either publication" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="520" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rpc" value="&lt;b&gt;[F] Authenticated local RPC server&lt;/b&gt;&lt;br&gt;ncalrpc: BfdWinService.Local.v1 / BfdLocal 1.1&lt;br&gt;Probe + GetSessionStatusV1&lt;br&gt;Broker SID ACL + exact SYSTEM caller / Authz&lt;br&gt;One snapshot per status query; four manager permits&lt;br&gt;Runtime management denied" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="760" width="500" height="195" as="geometry" />
        </mxCell>
        <mxCell id="bgp-client" value="&lt;b&gt;[B] Optional BGP worker&lt;/b&gt;&lt;br&gt;Get / Start / Stop from engine state&lt;br&gt;AdminDown releases BFD's own Stop when needed&lt;br&gt;Verify broker pipe PID against SCM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="1000" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="broker-token" value="&lt;b&gt;Broker process identity&lt;/b&gt;&lt;br&gt;SYSTEM + enabled broker service SID&lt;br&gt;Existing provider privileges and COM / MI security&lt;br&gt;No process-wide privilege stripping" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="90" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Status supervisor&lt;/b&gt;&lt;br&gt;Starts after SCM Running; normal polling: 1 s&lt;br&gt;One owned RPC worker; eight-second supervision budget&lt;br&gt;Stop remains responsive during backoff or native stalls" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="305" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Typed status cache: freshness needs receipts&lt;/b&gt;&lt;br&gt;Native MIDL bounds + checked Rust conversion&lt;br&gt;Fresh if snapshot age + fetch + elapsed &amp;le; 2 s&lt;br&gt;Invalid data clears cache; retry backoff: 1-30 s&lt;br&gt;Worker stall: quarantine until broker restart&lt;br&gt;Cache state never requests a BGP action" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF5EC;strokeColor=#558563;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="520" width="540" height="185" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;[F] RPC worker inside this broker process&lt;/b&gt;&lt;br&gt;Pin LocalService AND BFD service SID&lt;br&gt;QOS V5 / static Identify / EffectiveOnly / privacy&lt;br&gt;Asynchronous bind + status call: 2 s each&lt;br&gt;Pending state stays owned; no helper or reply pipe&lt;br&gt;Provider worker remains independent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="760" width="540" height="195" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;[C / D] BGP pipe / provider worker&lt;/b&gt;&lt;br&gt;Authorize restricted BFD account + service SID&lt;br&gt;Revert identification before native MI" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="1000" width="540" height="85" as="geometry" />
        </mxCell>
        <mxCell id="remote" value="&lt;b&gt;Remote BFD peer&lt;/b&gt;&lt;br&gt;UDP BFD / S-BFD&lt;br&gt;[A-fw] Program firewall rules&lt;br&gt;[A] Packet / path checks&lt;br&gt;Wire auth defaults to none" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;[D] Windows BGP provider / RRAS&lt;/b&gt;&lt;br&gt;Native PS_BgpPeer COM / MI; configured target&lt;br&gt;Provider and wire behavior: Windows-managed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1370" width="600" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bgp-peer" value="&lt;b&gt;Remote BGP peer&lt;/b&gt;&lt;br&gt;Connection managed by Windows RRAS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="1370" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="UDP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#506784;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="remote" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="scheduled publication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="engine" target="publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="one immutable view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="publisher" target="rpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="private LRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="client" target="rpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="validate result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="broker" source="client" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="BGP control pipe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="bgp-client" target="control">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="COM / MI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="control" target="provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="BGP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#506784;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;dashed=1;" edge="1" parent="1" source="provider" target="bgp-peer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Read the boundaries&lt;/b&gt;&lt;br&gt;Blue: BFD process / Purple: broker process and threads / Amber: authentication / Gray: Windows or peer&lt;br&gt;Dashed BGP link: Windows-managed external connection. Wire authentication is optional; its default is none.&lt;br&gt;SCM Running, successful RPC, fresh telemetry, and session Up are separate observations. Engine state drives BGP actions." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1570" width="1640" height="155" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 Service lifecycle" id="lifecycle">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1740" pageHeight="2100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Startup, status fetching, and administrative shutdown&lt;/b&gt;&lt;br&gt;SCM Running is a lifecycle receipt; session Up and fresh telemetry require separate checks" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=25;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="scm" value="&lt;b&gt;[E] Windows Service Control Manager&lt;/b&gt;&lt;br&gt;RpcSs → BfdBgpBroker → BfdWinService&lt;br&gt;Applies installed accounts, service SIDs, and privilege policy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="155" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;Broker service process&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="700" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="bfd" value="&lt;b&gt;BFD service | LocalService + restricted SID&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=20;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="310" width="700" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="broker-init" value="&lt;b&gt;1. Verify broker identity; initialize provider host&lt;/b&gt;&lt;br&gt;SYSTEM account + enabled broker service group&lt;br&gt;COM / MI initialization and protected target loading" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="80" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="broker-running" value="&lt;b&gt;2. Report SCM Running&lt;/b&gt;&lt;br&gt;BFD dependency startup does not wait for RPC success" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="250" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;3. Start supervisor and one RPC worker&lt;/b&gt;&lt;br&gt;Both are threads inside bfd-bgp-broker.exe&lt;br&gt;One in-flight call; polling: 1 s; backoff: 1-30 s&lt;br&gt;BGP pipe / provider worker remains independent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="440" width="640" height="145" as="geometry" />
        </mxCell>
        <mxCell id="call" value="&lt;b&gt;Authenticated bind + GetSessionStatusV1&lt;/b&gt;&lt;br&gt;Fixed BFD account / service-SID policy&lt;br&gt;Native asynchronous deadlines: 2 s bind + 2 s call&lt;br&gt;Supervisor budget: 8 s; never kill the native worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="900" width="640" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Supervise results; maintain the typed cache&lt;/b&gt;&lt;br&gt;Native bounds and Rust conversion before publication&lt;br&gt;Valid data: typed cache; reset retry history&lt;br&gt;Invalid / failed reply: clear cache; backoff 1–30 s&lt;br&gt;Stop interrupts backoff; no fabricated state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF5EC;strokeColor=#558563;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="660" width="640" height="160" as="geometry" />
        </mxCell>
        <mxCell id="quarantine" value="&lt;b&gt;Stuck worker: quarantine telemetry&lt;/b&gt;&lt;br&gt;Clear prior telemetry; retain native call storage&lt;br&gt;Log one Error 301; fetches stop until broker restart&lt;br&gt;Keep provider running; no BGP action or automatic restart" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="broker">
          <mxGeometry x="30" y="1150" width="640" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bfd-start" value="&lt;b&gt;4. SCM starts BFD after the broker dependency&lt;/b&gt;&lt;br&gt;StartPending checkpoints advance during initialization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="250" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bfd-guard" value="&lt;b&gt;5. Validate and reduce the BFD token&lt;/b&gt;&lt;br&gt;LocalService + enabled BFD service group&lt;br&gt;BFD SID + S-1-5-33 in restricting list&lt;br&gt;Remove unused privileges before configured resources" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="440" width="640" height="145" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;6. Create engine and its read-only status observer&lt;/b&gt;&lt;br&gt;Initial snapshot and capture metadata exist before RPC&lt;br&gt;Configured BGP startup uses its separate authorization probe" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="660" width="640" height="160" as="geometry" />
        </mxCell>
        <mxCell id="listener" value="&lt;b&gt;7. Register the private RPC interface&lt;/b&gt;&lt;br&gt;Deny runtime management before opening the endpoint&lt;br&gt;Explicit descriptor + per-call callback + manager authorization&lt;br&gt;Read one Arc snapshot; no engine lock or query messages" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="900" width="640" height="145" as="geometry" />
        </mxCell>
        <mxCell id="bfd-running" value="&lt;b&gt;8. Report Running; execute the packet engine&lt;/b&gt;&lt;br&gt;Lifecycle, RPC success, and session state are separate&lt;br&gt;Nominal publication: changed 100 ms / refresh 1 s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="bfd">
          <mxGeometry x="30" y="1150" width="640" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="start dependency" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#506784;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="scm" target="broker-init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="initialized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="broker" source="broker-init" target="broker-running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="background" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="broker" source="broker-running" target="monitor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="supervise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="broker" source="monitor" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="request / result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="broker" source="cache" target="call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="stalled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B98521;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="broker" source="call" target="quarantine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="dependency ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#506784;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="broker-running" target="bfd-start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="bfd-start" target="bfd-guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="reduced token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="bfd-guard" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-10" value="observer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="engine" target="listener">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="bfd" source="listener" target="bfd-running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="private status RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;startArrow=block;startFill=1;" edge="1" parent="1" source="call" target="listener">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shutdown" value="&lt;b&gt;Administrative shutdown and ownership&lt;/b&gt;&lt;br&gt;Close status observation when packet processing ends. On administrative stop, announce AdminDown as the role permits.&lt;br&gt;For a communicating classical session, repeat permitted announcements up to the MaxShutdownAnnounceMs limit.&lt;br&gt;Withdraw the latest BGP Stop issued by BFD with Start when needed. Finish the final action (20 s per broker call), then drain RPC.&lt;br&gt;SCM cleanup budgets: BFD 60 s plus announcement period; broker 60 s. These differ from the 8 s telemetry supervision budget.&lt;br&gt;Broker joins the RPC supervisor; an unfinished native worker retains its stack, binding, events, and output until completion or process exit.&lt;br&gt;Telemetry failures never request BGP actions. A stuck RPC worker is quarantined without launching replacements or aborting the provider host." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1780" width="1580" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 RPC authentication" id="authentication">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1990" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Mutual authentication and validated status replies&lt;/b&gt;&lt;br&gt;Identity receipts: exact account + enabled service SID / native bounds + one checked Rust conversion" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=25;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;In-process broker worker | SYSTEM + broker SID&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=19;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="500" height="1510" as="geometry" />
        </mxCell>
        <mxCell id="windows" value="&lt;b&gt;Windows RPC + kernel | conceptual checks&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=19;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="480" height="1510" as="geometry" />
        </mxCell>
        <mxCell id="server" value="&lt;b&gt;BFD server | LocalService + BFD SID&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=19;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;shape=swimlane;startSize=58;horizontal=1;collapsible=0;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="200" width="500" height="1510" as="geometry" />
        </mxCell>
        <mxCell id="token" value="&lt;b&gt;Verify the broker process identity&lt;/b&gt;&lt;br&gt;Exact SYSTEM account + enabled broker SID&lt;br&gt;Keep provider token and COM / MI security&lt;br&gt;No extra authentication privileges" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="client">
          <mxGeometry x="30" y="85" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;Validate BFD identity before registration&lt;/b&gt;&lt;br&gt;LocalService + enabled / restricting BFD SID&lt;br&gt;Deny runtime management before endpoint&lt;br&gt;WINNT authentication; own interface registration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="85" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="qos" value="&lt;b&gt;[F] One immutable BFD identity policy&lt;/b&gt;&lt;br&gt;QOS V5 / static / Identify / EffectiveOnly&lt;br&gt;WINNT packet privacy + mutual-auth flag&lt;br&gt;ServerSD requires LocalService AND BFD SID&lt;br&gt;UNIQUE_BINDING is not an auth-cache reset" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="client">
          <mxGeometry x="30" y="295" width="440" height="205" as="geometry" />
        </mxCell>
        <mxCell id="pin" value="&lt;b&gt;[F] Authenticate the actual server&lt;/b&gt;&lt;br&gt;Evaluate V5 ServerSecurityDescriptor&lt;br&gt;Both enabled SIDs must satisfy Member_of&lt;br&gt;Endpoint name and mutual flag alone are insufficient&lt;br&gt;Require the complete authenticated call" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="windows">
          <mxGeometry x="30" y="295" width="420" height="205" as="geometry" />
        </mxCell>
        <mxCell id="acl" value="&lt;b&gt;[F] Endpoint and interface ACLs&lt;/b&gt;&lt;br&gt;Protected DACL admits broker service SID&lt;br&gt;Interface ACL checked before security callback" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="295" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="attributes" value="&lt;b&gt;[F] Per-call security callback&lt;/b&gt;&lt;br&gt;Actual local ncalrpc + WINNT packet privacy&lt;br&gt;NullSession = FALSE; SEC_NO_CACHE every call" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="580" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="authz" value="&lt;b&gt;[F] Query the native caller identity&lt;/b&gt;&lt;br&gt;RpcGetAuthorizationContextForClient(FALSE)&lt;br&gt;Exact SYSTEM TokenUser + enabled broker group&lt;br&gt;Bounded / aligned buffers; RAII context release&lt;br&gt;No caller thread token / debug / impersonation privilege" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4D9;strokeColor=#B98521;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="820" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="manager" value="&lt;b&gt;Repeat authorization; read one snapshot&lt;/b&gt;&lt;br&gt;Nonblocking permit: at most four status managers&lt;br&gt;Copy fixed record on the RPC thread&lt;br&gt;Release Arc before native marshaling" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3A69A6;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="1120" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Convert the complete reply once&lt;/b&gt;&lt;br&gt;Native /robust ranges + Rust TryFrom / NonZero&lt;br&gt;Invalid reply: discard; retry with backoff&lt;br&gt;Check cache freshness separately from validity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF5EC;strokeColor=#558563;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="client">
          <mxGeometry x="30" y="1120" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;Complete before releasing call storage&lt;/b&gt;&lt;br&gt;Unbind → Free binding → release security data&lt;br&gt;Uncertain ownership: retain the single worker&lt;br&gt;8 s stall: telemetry quarantined; provider continues&lt;br&gt;Shutdown never waits indefinitely for that worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7957A2;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="client">
          <mxGeometry x="30" y="1310" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="&lt;b&gt;Fail closed on an identity or call error&lt;/b&gt;&lt;br&gt;No permissive/default BFD policy or endpoint fallback&lt;br&gt;No unverified record reaches the cache&lt;br&gt;Provider operations remain independent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="windows">
          <mxGeometry x="30" y="590" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ownership" value="&lt;b&gt;Separate responsibilities&lt;/b&gt;&lt;br&gt;Windows tokens authenticate each service&lt;br&gt;Status payload contains no command or target&lt;br&gt;MI / RPC coexistence tests use read-only traffic&lt;br&gt;Freshness is not the BFD detection timer&lt;br&gt;Recoverable RPC errors differ from fatal faults" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F6;strokeColor=#778397;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="windows">
          <mxGeometry x="30" y="840" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="management" value="&lt;b&gt;Separate runtime management surface&lt;/b&gt;&lt;br&gt;Enumeration / principal / statistics / listener&lt;br&gt;queries and listener control: always denied in BFD&lt;br&gt;Broker COM / MI process security unchanged" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="server">
          <mxGeometry x="30" y="1310" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="broker credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="client" source="token" target="qos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="register" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="server" source="start" target="acl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="bind / status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="qos" target="pin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="server accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="pin" target="acl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#506784;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="windows" source="pin" target="reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="ACL passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="server" source="acl" target="attributes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="attributes passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="server" source="attributes" target="authz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="caller authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="server" source="authz" target="manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="packet-private status reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3563A4;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="1" source="manager" target="result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-10" value="cleanup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7957A2;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=17;fontColor=#1C2B43;labelBackgroundColor=#FFFFFF;spacing=6;jettySize=auto;" edge="1" parent="client" source="result" target="release">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Scope and limits&lt;/b&gt;&lt;br&gt;BfdLocal 1.1: Probe + GetSessionStatusV1 / 336-byte native layout, not a raw-memory wire format / no keys or dynamic arrays.&lt;br&gt;Native C stubs and wrappers are outside safe Rust. RpcExceptionFilter reports recoverable RPC errors; fatal native faults remain unhandled.&lt;br&gt;See docs/rpc-session-status-design.md for accepted ranges, freshness, quarantine, and test scope." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2D0;strokeWidth=2;fontFamily=Segoe UI;fontSize=18;fontColor=#1C2B43;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1780" width="1600" height="155" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>