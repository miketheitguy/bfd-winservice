        <mxCell id="T1" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T1 / Portable protocol &amp;amp; configuration&lt;/div&gt;&lt;div&gt;Locked Cargo tests + optimized release tests&lt;br&gt;RFC 5880 / 7419 / 7880; malformed/auth/replay cases&lt;br&gt;State/timer, secrets, config and reflector invariants&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="110" y="240" as="geometry" />
