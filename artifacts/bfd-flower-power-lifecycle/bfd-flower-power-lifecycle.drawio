        <mxCell id="bfd_title" parent="bfd" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Cooper Black;fontSize=37;fontColor=#477B71;fontStyle=0;" value="05 / BfdWinService • the packet garden" vertex="1">
