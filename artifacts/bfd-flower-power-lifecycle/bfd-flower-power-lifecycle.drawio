        <mxCell id="T4" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T4 / Token &amp;amp; service-entry fixtures&lt;/div&gt;&lt;div&gt;Process-isolated account/group/restricted tokens&lt;br&gt;Reject missing/disabled/deny-only SIDs and privileges&lt;br&gt;SCM-only entry, malformed config, HKCU DPAPI fixtures&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="110" y="610" as="geometry" />
        </mxCell>
        <mxCell id="T5" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T5 / Dual RPC security connections&lt;/div&gt;&lt;div&gt;Authorized calls + anonymous/wrong identity rejection&lt;br&gt;Replacement server, protocol/privacy &amp;amp; management denial&lt;br&gt;Cancellation, malformed records, native SEH, MI coexistence&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="1320" y="610" as="geometry" />
        </mxCell>
