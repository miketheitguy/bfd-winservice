        <mxCell id="bfd" parent="1" style="rounded=1;arcSize=5;html=1;fillColor=#DCEBE8;strokeColor=#477B71;strokeWidth=4;container=1;collapsible=0;recursiveResize=0;" value="" vertex="1">
