        <mxCell id="L9" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L9 / Failure, recovery &amp;amp; restart&lt;/div&gt;&lt;div&gt;Transient socket faults back off while protocol timers continue&lt;br&gt;Fatal errors/crash use SCM recovery; ordinary Stop stays stopped&lt;/div&gt;&lt;/div&gt;" vertex="1">
