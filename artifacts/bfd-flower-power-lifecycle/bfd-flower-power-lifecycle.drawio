        <mxCell id="L1" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L1 / Remote BFD / S-BFD peers&lt;/div&gt;&lt;div&gt;IPv4 or IPv6 • 3784 single-hop / 4784 multihop&lt;br&gt;7784 S-BFD requests; replies to initiator source port&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1260" x="110" y="230" as="geometry" />
        </mxCell>
        <mxCell id="L2" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L2 / Elevated offline installation&lt;/div&gt;&lt;div&gt;Verify download hash → setup/runtime/MSI transaction&lt;br&gt;Provision payload, service policy, ACLs, events &amp;amp; firewall&lt;/div&gt;&lt;/div&gt;" vertex="1">
