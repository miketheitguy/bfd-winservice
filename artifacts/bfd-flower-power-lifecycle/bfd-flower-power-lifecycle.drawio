          <mxGeometry height="170" width="1260" x="110" y="680" as="geometry" />
        </mxCell>
        <mxCell id="L4" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L4 / Windows SCM issues service tokens&lt;/div&gt;&lt;div&gt;BFD starts independently; broker depends only on RpcSs&lt;br&gt;Delayed auto start; minimum privilege and service-SID policy&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1260" x="110" y="905" as="geometry" />
        </mxCell>
        <mxCell id="L5" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L5 / Fail-closed startup gates&lt;/div&gt;&lt;div&gt;Check exact account, enabled service SID and privileges&lt;br&gt;BFD also checks restricting SIDs before resources or endpoints&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1260" x="110" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="L6" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L6 / Worker and endpoint readiness&lt;/div&gt;&lt;div&gt;Validate configuration → initial observer → secure endpoints&lt;br&gt;Report Running after bounded readiness; monitor starts afterward&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1260" x="110" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="L7" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#E6EBD4;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L7 / Separate operational states&lt;/div&gt;&lt;div&gt;SCM Running = service lifecycle; BFD Up = accepted probes&lt;br&gt;RPC success and BGP Connected have independent meaning&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1260" x="110" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="L8" parent="host" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;L8 / Orderly stop / preshutdown&lt;/div&gt;&lt;div&gt;Close observer → announce AdminDown → finish final BGP action&lt;br&gt;Drain RPC; bound cleanup; BFD preshutdown provisioned at 125 s&lt;/div&gt;&lt;/div&gt;" vertex="1">
