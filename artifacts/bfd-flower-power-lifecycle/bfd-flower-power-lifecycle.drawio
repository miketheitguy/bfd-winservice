        <mxCell id="broker_title" parent="broker" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Cooper Black;fontSize=37;fontColor=#735078;fontStyle=0;" value="07 / BfdBgpBroker" vertex="1">
          <mxGeometry height="65" width="1390" x="70" y="38" as="geometry" />
        </mxCell>
        <mxCell id="broker_sub" parent="broker" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#735F5E;fontStyle=0;" value="SYSTEM + broker service SID • only SeChangeNotifyPrivilege" vertex="1">
          <mxGeometry height="65" width="1390" x="70" y="114" as="geometry" />
        </mxCell>
        <mxCell id="G1" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G1 / Broker COM/MI host&lt;/div&gt;&lt;div&gt;Verify own SCM-issued identity&lt;br&gt;Set process COM security before provider use&lt;br&gt;Provider runs as broker, without caller token&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="110" y="240" as="geometry" />
        </mxCell>
        <mxCell id="G2" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G2 / Protected fixed target&lt;/div&gt;&lt;div&gt;Read configured peer + routing domain&lt;br&gt;Get / Start / Stop are the only operations&lt;br&gt;No public COM class factory or UDP listener&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="810" y="240" as="geometry" />
        </mxCell>
        <mxCell id="G3" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G3 / Native MI provider worker&lt;/div&gt;&lt;div&gt;Serialized local PS_BgpPeer requests&lt;br&gt;Get / Start / Stop through MI + COM&lt;br&gt;Provider identity stays the reduced SYSTEM token&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="110" y="670" as="geometry" />
        </mxCell>
        <mxCell id="G4" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G4 / Checked provider outcomes&lt;/div&gt;&lt;div&gt;Reject unknown/ambiguous connectivity&lt;br&gt;Start/Stop require success and peer read-back&lt;br&gt;Cancellation cannot undo an executed operation&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="810" y="670" as="geometry" />
        </mxCell>
        <mxCell id="G5" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G5 / Bounded dispatcher&lt;/div&gt;&lt;div&gt;One admitted control manager + one queued request&lt;br&gt;Discard cancelled/expired work before execution&lt;br&gt;Idle waits on request/stop events&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="110" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="G6" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G6 / Provider watchdog&lt;/div&gt;&lt;div&gt;20 s active request supervision&lt;br&gt;Crash exit → SCM restart after 5 s&lt;br&gt;Pending failure retries; completed action not replayed&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="810" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="G7" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G7 / BGP control server&lt;/div&gt;&lt;div&gt;Authorize LocalService + BFD service SID&lt;br&gt;Accept fixed operations for protected target&lt;br&gt;RPC disconnect alone never changes the peer&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="110" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="G8" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G8 / Broker stop &amp;amp; diagnostics&lt;/div&gt;&lt;div&gt;Stop provider/telemetry supervision&lt;br&gt;Retain unfinished native call storage&lt;br&gt;Own background ETW writer; 60 s stop budget&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="810" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="G9" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G9 / In-process telemetry worker&lt;/div&gt;&lt;div&gt;After Running, query BFD and validate reply&lt;br&gt;2 s bind / 2 s call / 8 s supervision&lt;br&gt;One stalled worker is retained and quarantined&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="110" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="G10" parent="broker" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#E6EBD4;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;G10 / Checked observational cache&lt;/div&gt;&lt;div&gt;Validate complete record and freshness&lt;br&gt;Unavailable/invalid/stale → no fabricated state&lt;br&gt;Cache never drives BGP; provider stays independent&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="610" x="810" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="broker_note" parent="broker" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=23;fontColor=#735F5E;fontStyle=0;" value="Control retries use a dedicated BFD worker; provider and telemetry failure domains remain independent." vertex="1">
          <mxGeometry height="55" width="1310" x="110" y="2330" as="geometry" />
        </mxCell>
