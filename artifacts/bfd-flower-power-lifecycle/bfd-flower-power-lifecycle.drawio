        <mxCell id="rpc_title" parent="rpc" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Cooper Black;fontSize=37;fontColor=#C95C31;fontStyle=0;" value="06 / Two local paths" vertex="1">
          <mxGeometry height="65" width="910" x="70" y="38" as="geometry" />
        </mxCell>
        <mxCell id="rpc_sub" parent="rpc" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#735F5E;fontStyle=0;" value="Security checks apply to both" vertex="1">
          <mxGeometry height="65" width="910" x="70" y="114" as="geometry" />
        </mxCell>
        <mxCell id="R1" parent="rpc" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;R1 / Binding &amp;amp; server identity&lt;/div&gt;&lt;div&gt;ncalrpc only; WINNT + packet privacy&lt;br&gt;Static Identify/effective-only credentials&lt;br&gt;V5 pins exact account AND service SID&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="830" x="110" y="240" as="geometry" />
        </mxCell>
        <mxCell id="R2" parent="rpc" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;R2 / Endpoint &amp;amp; caller authorization&lt;/div&gt;&lt;div&gt;Protected service-SID ACLs&lt;br&gt;Every call: actual transport/auth + exact account&lt;br&gt;Enabled service SID through Authz; no impersonation&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="830" x="110" y="670" as="geometry" />
        </mxCell>
        <mxCell id="R3" parent="rpc" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;R3 / Native ownership &amp;amp; deadlines&lt;/div&gt;&lt;div&gt;Bounded records, admission and real async deadlines&lt;br&gt;Cancel/complete before freeing native call storage&lt;br&gt;Deny runtime management; no reverse RPC callbacks&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="830" x="110" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="R4" parent="rpc" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#F3DBDE;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;R4 / BGP control → broker&lt;/div&gt;&lt;div&gt;BFD initiates Get / Start / Stop&lt;br&gt;BfdWinService.Bgp.v2 • BgpControl 2.0&lt;br&gt;Request carries no caller-selected target&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="830" x="110" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="R5" parent="rpc" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#C95C31;fillColor=#E6EBD4;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#C95C31;margin-bottom:13px&quot;&gt;R5 / Session status → BFD&lt;/div&gt;&lt;div&gt;Broker initiates GetSessionStatusV1&lt;br&gt;BfdWinService.Local.v2 • BfdLocal 2.0&lt;br&gt;Replies return on the same initiated call&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="830" x="110" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="rpcnote" parent="rpc" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=23;fontColor=#735F5E;fontStyle=0;" value="Orange arrows identify call initiation. Authorization callbacks are receiver-local checks." vertex="1">
          <mxGeometry height="60" width="830" x="110" y="2330" as="geometry" />
        </mxCell>
        <mxCell id="e66" edge="1" parent="rpc" source="R1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=28;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#477B71;fontColor=#477B71;fontSize=22;fontFamily=Segoe UI;labelBackgroundColor=#FBF2DB;labelBorderColor=none;curved=0;" target="R2" value="authenticate">
