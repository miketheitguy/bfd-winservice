        <mxCell id="bfd_sub" parent="bfd" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#735F5E;fontStyle=0;" value="LocalService + restricted BFD service SID • only SeChangeNotifyPrivilege • one mutable engine owner" vertex="1">
          <mxGeometry height="65" width="2040" x="70" y="114" as="geometry" />
        </mxCell>
        <mxCell id="B1" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B1 / UDP transport&lt;/div&gt;&lt;div&gt;Exclusive sockets; stable 49152–65535 source&lt;br&gt;Ancillary destination, interface, TTL/hop limit&lt;br&gt;Event-driven receive / stop / settings waits&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="110" y="240" as="geometry" />
        </mxCell>
        <mxCell id="B2" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B2 / Path acceptance&lt;/div&gt;&lt;div&gt;Firewall is a separate kernel gate&lt;br&gt;Peer / point-to-point, port, destination &amp;amp; interface&lt;br&gt;Single-hop TTL=255; optional MinTtl elsewhere&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="790" y="240" as="geometry" />
        </mxCell>
        <mxCell id="B3" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B3 / Wire packet &amp;amp; auth&lt;/div&gt;&lt;div&gt;Header, length, flags and discriminators&lt;br&gt;None, password, meticulous MD5, keyed/meticulous SHA-1&lt;br&gt;Digest/replay checks precede state updates&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="1470" y="240" as="geometry" />
        </mxCell>
        <mxCell id="B4" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B4 / Classical BFD&lt;/div&gt;&lt;div&gt;One asynchronous single-/multihop session&lt;br&gt;Down → Init → Up; passive &amp;amp; Demand handling&lt;br&gt;Poll/Final, learned discriminator &amp;amp; diagnostics&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="110" y="670" as="geometry" />
        </mxCell>
        <mxCell id="B5" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B5 / S-BFD initiator&lt;/div&gt;&lt;div&gt;Provisioned remote discriminator; direct Up&lt;br&gt;Bounded outstanding probes + reply correlation&lt;br&gt;Replay/expiry checks and anycast sources&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="790" y="670" as="geometry" />
        </mxCell>
        <mxCell id="B6" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B6 / S-BFD reflector&lt;/div&gt;&lt;div&gt;One stateless listener, many initiators&lt;br&gt;Demand/loop checks; reverse discriminator pair&lt;br&gt;Sequence reflection + bounded per-source replies&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="1470" y="670" as="geometry" />
        </mxCell>
        <mxCell id="B7" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B7 / Timer &amp;amp; work scheduler&lt;/div&gt;&lt;div&gt;Negotiated TX/RX, jitter, detection expiry&lt;br&gt;Poll timing, suppression &amp;amp; congestion backoff&lt;br&gt;Reuse waits; bound receive and event work&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="110" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="B8" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#E6EBD4;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B8 / Single-owner engine&lt;/div&gt;&lt;div&gt;Selected protocol role owns accepted state&lt;br&gt;Run receive, expiry, transmission &amp;amp; transitions&lt;br&gt;Fan out observations and optional BGP actions&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="790" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="B9" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B9 / Transmit &amp;amp; socket recovery&lt;/div&gt;&lt;div&gt;Prepare → send → commit only on success&lt;br&gt;Failed send keeps sequence/Poll/probe uncommitted&lt;br&gt;Receive/wait recovery uses 10–250 ms backoff&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="1470" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="B10" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B10 / Settings updates&lt;/div&gt;&lt;div&gt;Registry notification reloads S-BFD timing&lt;br&gt;Reflector maintenance changes Up/AdminDown&lt;br&gt;Startup role, key &amp;amp; BGP target need restart&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="110" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="B11" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B11 / Immutable telemetry&lt;/div&gt;&lt;div&gt;Coherent ArcSwap snapshots; no reader lock&lt;br&gt;100 ms change spacing / 1 s refresh target&lt;br&gt;Counters publish on existing engine wakes&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="790" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="B12" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B12 / BGP policy &amp;amp; mailbox&lt;/div&gt;&lt;div&gt;Optional; first Up enables Get / Start-if-stopped&lt;br&gt;Later Down → Stop; AdminDown releases own Stop&lt;br&gt;Bounded latest Stop/Start pair; worker off engine&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="1470" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="B13" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B13 / Engine shutdown&lt;/div&gt;&lt;div&gt;Invalidate status observer immediately&lt;br&gt;Role-permitted AdminDown announcements&lt;br&gt;Release own BGP Stop; finish bounded final action&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="110" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="B14" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B14 / Bounded diagnostics&lt;/div&gt;&lt;div&gt;Lifecycle, communication, state, auth &amp;amp; errors&lt;br&gt;Background writer → ETW + optional file&lt;br&gt;UTC lines; 64 MiB rotation + one backup&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="790" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="B15" parent="bfd" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#477B71;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#477B71;margin-bottom:13px&quot;&gt;B15 / Status RPC server&lt;/div&gt;&lt;div&gt;Read-only GetSessionStatusV1&lt;br&gt;Authorize broker; copy one fixed snapshot&lt;br&gt;No packet-loop query; unregister and drain&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="600" x="1470" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="bfd_limits" parent="bfd" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=23;fontColor=#735F5E;fontStyle=0;" value="Multihop BGP requires meticulous authentication; reflectors reject BGP control. Classical Demand initiation, Echo, multipoint and discriminator signaling are unsupported." vertex="1">
