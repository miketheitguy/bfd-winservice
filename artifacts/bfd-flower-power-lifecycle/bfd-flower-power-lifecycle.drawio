        <mxCell id="T10" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T10 / Fuzz inputs &amp;amp; mutation&lt;/div&gt;&lt;div&gt;Locked separate workspace → generate deterministic seeds&lt;br&gt;Structured authenticated mutation + raw-byte fallback&lt;br&gt;Synthetic public key bytes; bounded action sequences&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="110" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="T11" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T11 / Four ASan fuzz targets&lt;/div&gt;&lt;div&gt;packet • classical session • initiator • reflector&lt;br&gt;Coverage-guided libFuzzer + explicit acceptance oracles&lt;br&gt;In-memory only; 5 s/input, 2 GiB, bounded run count/time&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="1320" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="T12" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T12 / Failure → durable regression&lt;/div&gt;&lt;div&gt;Collect coverage/logs and preserve crash input&lt;br&gt;Replay exact target/input → investigate → fix → regression&lt;br&gt;Keep source receipts; rerun affected validation&lt;/div&gt;&lt;/div&gt;" vertex="1">
