        <mxCell id="T2" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T2 / Native UDP connection harness&lt;/div&gt;&lt;div&gt;Loopback engine + real IPv4/IPv6 sockets&lt;br&gt;TTL, interface, ports, auth, Poll/Final and shutdown&lt;br&gt;S-BFD anycast, multiple clients and live settings&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="1320" y="240" as="geometry" />
        </mxCell>
        <mxCell id="T3" parent="tests" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=27;strokeWidth=2.4;strokeColor=#735078;fillColor=#FFFBEF;shadow=0;" value="&lt;div style=&quot;font-family:Segoe UI;font-size:25px;line-height:1.3;color:#462D42&quot;&gt;&lt;div style=&quot;font-family:Cooper Black;font-size:29px;color:#735078;margin-bottom:13px&quot;&gt;T3 / Publication &amp;amp; telemetry pressure&lt;/div&gt;&lt;div&gt;Retain snapshots and run busy readers during UDP&lt;br&gt;Check freshness, invalid records, retry &amp;amp; quarantine&lt;br&gt;Verify packet timing and engine progress&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="1100" x="2530" y="240" as="geometry" />
